#!/bin/sh
# pre-push：push 前无条件结构门禁 + 按出站改动面精准分派免环境窄检查（enforcement 通道，2026-09-27 立；2026-11-27 BUG-406/407 职责归位）。
# 为什么：DSH 立场——"Agents follow enforced gates far more reliably than prose conventions"。
#       同时守「push = 免浏览器/免 DSH_HOME 的秒级确定性安全网」的边界（BUG-406/407）：
#       - 无条件必跑：全量结构门禁 `node checks/run-gates.mjs`（verify）；
#       - 按出站改动面精准执行（`checks/pre-push-surfaces.mjs --exec-plan`，规则唯一家 = `tools/lib/core/asset-lanes.mjs`）：
#         docs-only 快速路径只跑 verify；代码/测试/工具/门禁/探针跑受影响的增量 typecheck / lint / dup / smoke:fast / test:checks，
#         再跑最多一次合并去重 Vitest（超阈值自动回退单次全测）；未分类改动面 fail-closed 阻断（BUG-199）。
#       - 需要真 DSH 服务器/真 Chromium 的真入口车道（`client-load` / `preset` / `replay`）不阻塞 `git push`：
#         改由开发收口 `source run/env.sh && pnpm smoke:surface` 与发版前 `pnpm release --verify` 强制兜底（每周 CI 另覆盖 `replay`、`coverage:ratchet` 与 `channel-matrix`）。
# 负例留证（2026-09-27）：AGENTS.md 临时加死链 → push 被 verify 拦下（未触网络层）；还原 → 放行到网络层。
#        （2026-11-13）：改 client 文件不跑 client-load-smoke 直接 push → surface lane 拦下并点名；还原后按面检查 PASS → 绿。
#        （2026-11-27 BUG-406）：docs-only `--exec-plan --dry-run` 仅跑 verify（跳过 tsc/vitest）；改 probes 精准带出 entry-import-graph.spec.ts；改 src/client 精准带出 typecheck/lint/dup/vitest related/client-load。
# bypass：git push --no-verify（紧急逃生门；用了要在收尾 Note 说明原因）。
refs_file=$(mktemp "${TMPDIR:-/tmp}/dsh-prepush-refs.XXXXXX") || exit 1
if [ -t 0 ]; then
  : > "$refs_file"            # 手动直跑 hook：没有 stdin，交给 surfaces 脚本打印"退化"
else
  cat > "$refs_file"          # git push 管道喂入的 ref 清单（不消费会阻塞）
fi
cd "$(git rev-parse --show-toplevel)" || exit 1
node checks/run-gates.mjs || { rm -f "$refs_file"; exit 1; }
node checks/pre-push-surfaces.mjs --stdin "$refs_file" --exec-plan
status=$?
rm -f "$refs_file"
exit "$status"
