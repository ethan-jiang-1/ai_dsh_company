#!/bin/sh
# pre-push：push 前跑全量结构门禁 + keyless 行为测试 + 按面的真入口检查（enforcement 通道，2026-09-27 立；接线 = run/env.sh 幂等设 core.hooksPath）。
# 为什么：DSH 立场——"Agents follow enforced gates far more reliably than prose conventions"。
#       实测 2026-11-13：冷分项和 ~44s（verify 8.3 + typecheck 5.4 + lint/dup 1.4 + smoke:fast 2.4 + test 26）；热缓存全链 29–35s（两次实测；test 14–18s）。
#       仍守「hook 只装便宜高置信缺陷」的边界：慢 E2E（安装/发布/真模型）不进 hook。
#       分工 = hook 管「忘跑」（verify+typecheck+lint+dup+smoke:fast+surface+coverage 都强制），CI 管「环境差异/绕过」（verify 穷举档）。
#        test 进 hook 而非 CI（2026-09-28 实证定界）：vitest 的 vendor 内部 @deepseek-ai/* 解析依赖
#        已构建 lib——本地 dev 树按 bootstrap 必然已构建所以跑得动；CI 干净环境没有，而补齐 =
#        全量 vendor 构建链（DSH 自己的 test 脚本也是 build && vitest），负担不成比例。
#        ⇒ 分工 = hook 管「忘跑」（verify+typecheck+lint+dup+test 都强制），CI 管「环境差异/绕过」（verify 穷举档）。
# 2026-11-13（研究 B 件）：加「按面触发」——真入口检查（client 装配 / preset 挂载 / 回放 / 进程级写面）
#        原本不在任何 required lane 里。规则唯一家 = tools/lib/asset-lanes.mjs 的 SURFACE_RULES；
#        hook 把 git 喂进来的 ref 清单交给 checks/pre-push-surfaces.mjs，由它算 outgoing 范围再选检查。
#        成本：只在改到对应面时增加（client ~25s / presets ~30s / content ~2s）。
# 负例留证（2026-09-27）：AGENTS.md 临时加死链 → push 被 verify 拦下（未触网络层）；还原 → 放行到网络层。
#        （2026-09-28）：临时失败 spec → hook 红；删除 → 绿。
#        （2026-11-03）：临时写 `const x: number = 's'` → typecheck 拦下；还原 → 绿。
#        （2026-11-04）：临时把 instance-guard 的 if/else 改回三元 → lint 拦下；还原 → 绿。
#                      临时在 tools/lib 放 10 行复制块 → dup 拦下；删除 → 绿。
#        （2026-11-13）：改 client 文件不跑 client-load-smoke 直接 push → surface lane 拦下并点名；
#                      还原后按面检查 PASS → 绿（见 notes/implemented 的本件 Note）。
# bypass：git push --no-verify（紧急逃生门；用了要在收尾 Note 说明原因）。
refs_file=$(mktemp "${TMPDIR:-/tmp}/dsh-prepush-refs.XXXXXX") || exit 1
if [ -t 0 ]; then
  : > "$refs_file"            # 手动直跑 hook：没有 stdin，交给 surfaces 脚本打印"退化"
else
  cat > "$refs_file"          # git push 管道喂入的 ref 清单（不消费会阻塞）
fi
cd "$(git rev-parse --show-toplevel)" || exit 1
node checks/run-gates.mjs || { rm -f "$refs_file"; exit 1; }
node ./node_modules/typescript/bin/tsc -b packages/company-pack || { rm -f "$refs_file"; exit 1; }
node ./node_modules/typescript/bin/tsc -p tsconfig.test-client.json || { rm -f "$refs_file"; exit 1; }
node ./node_modules/typescript/bin/tsc -p tsconfig.test-company.json || { rm -f "$refs_file"; exit 1; }
node ./node_modules/typescript/bin/tsc -p tsconfig.test-harness.json || { rm -f "$refs_file"; exit 1; }
pnpm -s lint || { rm -f "$refs_file"; exit 1; }
pnpm -s dup || { rm -f "$refs_file"; exit 1; }
pnpm -s smoke:fast || { rm -f "$refs_file"; exit 1; }
node checks/pre-push-surfaces.mjs --stdin "$refs_file" || { rm -f "$refs_file"; exit 1; }
rm -f "$refs_file"
# 覆盖率 = 执行下限（C 件）：跑全量测试并比基线棘轮（只升不降；新文件有下限；已知空洞须豁免）。
exec node checks/audit/coverage-ratchet.mjs
