{
  "extends": "./packages/company-pack/tsconfig.host.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["node"],
    "paths": {
      "@deepseek-ai/*": ["./packages/company-pack/node_modules/@deepseek-ai/*"],
      "@deepseek-ai/dsh-api-session-controller/client": ["./packages/company-pack/node_modules/@deepseek-ai/dsh-api-session-controller/lib/types/client/index.d.ts"],
      "@deepseek-ai/dsh-api-session-controller/types": ["./packages/company-pack/node_modules/@deepseek-ai/dsh-api-session-controller/lib/types/types.d.ts"],
      "@deepseek-ai/dsh-session/types": ["./packages/company-pack/node_modules/@deepseek-ai/dsh-session/lib/types/types.d.ts"]
    }
  },
  "include": [
    "tests/harness/**/*.spec.ts",
    "tests/support/temp-env.ts"
  ],
  "exclude": [
    "tests/harness/repo/pack-exports.spec.ts"
  ]
}
