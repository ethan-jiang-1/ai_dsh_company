{
  "extends": "./packages/company-pack/tsconfig.host.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["node"],
    "paths": {
      "@deepseek-ai/*": ["./packages/company-pack/node_modules/@deepseek-ai/*"],
      "@deepseek-ai/dsh-api-session-controller/client": ["./packages/company-pack/node_modules/@deepseek-ai/dsh-api-session-controller/lib/types/client/index.d.ts"],
      "@deepseek-ai/dsh-api-session-controller/types": ["./packages/company-pack/node_modules/@deepseek-ai/dsh-api-session-controller/lib/types/types.d.ts"],
      "@deepseek-ai/dsh-session/types": ["./packages/company-pack/node_modules/@deepseek-ai/dsh-session/lib/types/types.d.ts"]
    }
  },
  "include": [
    "tests/harness/navigation-assets.spec.ts",
    "tests/harness/skip-budget.spec.ts",
    "tests/harness/notes-audit.spec.ts",
    "tests/harness/snapshots-budget.spec.ts",
    "tests/harness/release-foundation.spec.ts",
    "tests/harness/market-index.spec.ts",
    "tests/harness/collaboration-evidence.spec.ts",
    "tests/harness/member-stale-evidence.spec.ts",
    "tests/harness/team-barrier-evidence.spec.ts",
    "tests/harness/prune-policy.spec.ts",
    "tests/harness/backlog-liveness.spec.ts",
    "tests/harness/recovery-scope-evidence.spec.ts",
    "tests/harness/workspace-oracle.spec.ts",
    "tests/harness/deliverables-audit.spec.ts",
    "tests/harness/converge-rules.spec.ts",
    "tests/harness/claim-loser-evidence.spec.ts",
    "tests/harness/question-stop.spec.ts",
    "tests/harness/entry-probe.spec.ts",
    "tests/harness/probe-web.spec.ts",
    "tests/harness/orient.spec.ts",
    "tests/support/temp-env.ts"
  ]
}
