{
  "name": "dsh-company-pack",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Virtual company multi-role plugin pack: 5 role presets (CEO / VP-Eng / VP-Sales / COO / CFO) + host bundle rows + deployment brand skin. Design docs: docs/index.md",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "presets/**",
    "cordis.patch.yml"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent-instructions": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-agent-preset": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-experimental-agent-team": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-experimental-client-ui-agent-team": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-experimental-tool-agent-team": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-persona": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-tool-ask-user": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-tool-fs": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-tool-fs-search": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-tool-present": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-tool-skill": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-tool-subagent": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-tool-subagent-control": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-tool-todo": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-user-approval": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": "^0.1.7-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "@deepseek-ai/dsh-agent-instructions": "workspace:*",
    "@deepseek-ai/dsh-api-remotes": "workspace:*",
    "@deepseek-ai/dsh-api-session-controller": "workspace:*",
    "@deepseek-ai/dsh-api-workspace-files": "workspace:*",
    "@deepseek-ai/dsh-client-ui-conversation": "workspace:*",
    "@deepseek-ai/dsh-client-ui-dockkit": "workspace:*",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:*",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:*",
    "@deepseek-ai/dsh-client-ui-sidebar": "workspace:*",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "workspace:*",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:*",
    "@deepseek-ai/dsh-client-ui-tool": "workspace:*",
    "@deepseek-ai/dsh-experimental-agent-team": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-session-stats": "workspace:*",
    "@deepseek-ai/dsh-token-meter": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-user-approval": "workspace:*",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/ceo/agent.cordis.yml",
        "./presets/vp-eng/agent.cordis.yml",
        "./presets/vp-sales/agent.cordis.yml",
        "./presets/coo/agent.cordis.yml",
        "./presets/cfo/agent.cordis.yml"
      ]
    },
    "compatibility": {
      "dshReleases": [
        "dsh-v0.1.5-rc.2",
        "dsh-v0.1.7-rc.2"
      ]
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  }
}
