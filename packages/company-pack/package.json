{
  "name": "dsh-company-pack",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Virtual company multi-role plugin pack: 4 role presets (CEO / VP-Eng / VP-Sales / COO) + host bundle rows + deployment brand skin. Design docs: docs/00-index.md",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "presets/**",
    "cordis.patch.yml"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-agent-presets": "0.1.5-rc.2",
    "@deepseek-ai/dsh-persona": "0.1.5-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tool-fs": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tool-fs-search": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tool-skill": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tool-todo": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tool-ask-user": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tool-subagent": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tool-present": "0.1.5-rc.2",
    "@deepseek-ai/dsh-experimental-agent-team": "0.1.5-rc.2",
    "@deepseek-ai/dsh-experimental-tool-agent-team": "0.1.5-rc.2",
    "@deepseek-ai/dsh-experimental-client-ui-agent-team": "0.1.5-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "@deepseek-ai/dsh-api-remotes": "workspace:*",
    "@deepseek-ai/dsh-api-session-controller": "workspace:*",
    "@deepseek-ai/dsh-client-ui-conversation": "workspace:*",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:*",
    "@deepseek-ai/dsh-client-ui-sidebar": "workspace:*",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:*",
    "@deepseek-ai/dsh-experimental-agent-team": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  }
}
