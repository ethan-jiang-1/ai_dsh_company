{
  "name": "ai-dsh-company",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "setup": "node tools/dev/setup.mjs",
    "prepare": "node tools/dev/hooks-install.mjs",
    "dsh": "node --import tsx/esm vendor/dsh/apps/cli/src/bin.ts",
    "company": "node tools/dev/company.mjs",
    "dev:pack": "node ./node_modules/typescript/bin/tsc -b packages/company-pack && (trap 'kill 0' INT TERM EXIT; node ./node_modules/typescript/bin/tsc -b packages/company-pack --watch --preserveWatchOutput & cd packages/company-pack && ../../node_modules/.bin/tsdown --watch lib/types --on-success 'node ../../tools/dev/build-client.mjs --fingerprint-only' & wait)",
    "bundle:init": "node tools/dev/bundle-init.mjs",
    "methods:init": "node tools/dev/methods-init.mjs",
    "orient": "node probes/analyze/orient-probe.mjs",
    "notes:audit": "node probes/analyze/notes-audit-probe.mjs",
    "gen:catalog": "node tools/repo/gen-catalog.mjs",
    "diagnose": "node probes/analyze/diagnose-probe.mjs",
    "verify": "node checks/run-gates.mjs",
    "test": "vitest run",
    "smoke:fast": "node checks/lanes/fast-lane.mjs",
    "smoke:surface": "node checks/pre-push-surfaces.mjs --lanes-only",
    "smoke:all": "node checks/lanes/keyless-lane.mjs",
    "coverage:ratchet": "node checks/audit/coverage-ratchet.mjs",
    "typecheck": "node ./node_modules/typescript/bin/tsc -b packages/company-pack && node ./node_modules/typescript/bin/tsc -p tsconfig.test-client.json && node ./node_modules/typescript/bin/tsc -p tsconfig.test-company.json && node ./node_modules/typescript/bin/tsc -p tsconfig.test-harness.json && node ./node_modules/typescript/bin/tsc -p tsconfig.test-vendor-bridge.json",
    "lint": "oxlint --config .oxlintrc.json --deny-warnings packages/company-pack/src tests && node checks/audit/company-static-audit.mjs --strict",
    "dup": "jscpd --config .jscpd.json",
    "release": "node tools/release/release.mjs",
    "release:check": "node tools/release/release.mjs --check",
    "release:prepare": "node tools/release/release.mjs --prepare",
    "release:verify": "node tools/release/release.mjs --verify",
    "release:stamp": "node tools/release/release.mjs --stamp",
    "release:shape": "node tools/release/shipped-shape.mjs",
    "release:all": "node tools/release/release.mjs --all",
    "market:hosted": "node tools/release/market-index.mjs --check --hosted",
    "test:coverage": "vitest run --coverage",
    "test:spec": "vitest run",
    "test:e2e": "node checks/lanes/keyless-lane.mjs --suffix e2e",
    "test:entry": "node checks/lanes/keyless-lane.mjs --suffix entry",
    "test:checks": "node tools/repo/run-check-tests.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "@deepseek-ai/dsh-agent-instructions": "workspace:*",
    "@deepseek-ai/dsh-agent-preset": "workspace:*",
    "@deepseek-ai/dsh-agent-preset-registry": "workspace:*",
    "@deepseek-ai/dsh-browser-use": "workspace:*",
    "@deepseek-ai/dsh-command-compact": "workspace:*",
    "@deepseek-ai/dsh-command-goal": "workspace:*",
    "@deepseek-ai/dsh-compaction-basic": "workspace:*",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "workspace:*",
    "@deepseek-ai/dsh-experimental-agent-team": "workspace:*",
    "@deepseek-ai/dsh-experimental-browser-use-playwright-mcp": "workspace:*",
    "@deepseek-ai/dsh-experimental-client-ui-agent-team": "workspace:*",
    "@deepseek-ai/dsh-experimental-tool-agent-team": "workspace:*",
    "@deepseek-ai/dsh-llm-replay": "workspace:*",
    "@deepseek-ai/dsh-persona": "workspace:*",
    "@deepseek-ai/dsh-plan-mode": "workspace:*",
    "@deepseek-ai/dsh-session-query-sqlite": "workspace:*",
    "@deepseek-ai/dsh-session-snapshot": "workspace:*",
    "@deepseek-ai/dsh-skill-filesystem": "workspace:*",
    "@deepseek-ai/dsh-time-context": "workspace:*",
    "@deepseek-ai/dsh-tool-ask-user": "workspace:*",
    "@deepseek-ai/dsh-tool-bash": "workspace:*",
    "@deepseek-ai/dsh-tool-cordis": "workspace:*",
    "@deepseek-ai/dsh-tool-fs": "workspace:*",
    "@deepseek-ai/dsh-tool-fs-search": "workspace:*",
    "@deepseek-ai/dsh-tool-goal": "workspace:*",
    "@deepseek-ai/dsh-tool-jobs": "workspace:*",
    "@deepseek-ai/dsh-tool-present": "workspace:*",
    "@deepseek-ai/dsh-tool-schedule": "workspace:*",
    "@deepseek-ai/dsh-tool-session-query": "workspace:*",
    "@deepseek-ai/dsh-tool-skill": "workspace:*",
    "@deepseek-ai/dsh-tool-subagent": "workspace:*",
    "@deepseek-ai/dsh-tool-subagent-control": "workspace:*",
    "@deepseek-ai/dsh-tool-todo": "workspace:*",
    "@deepseek-ai/dsh-tool-web": "workspace:*",
    "@deepseek-ai/dsh-tool-workflow": "workspace:*",
    "@deepseek-ai/dsh-workflow-ptc": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "^4.1.11",
    "dsh-company-pack": "workspace:*",
    "jscpd": "5.1.2",
    "lightningcss": "^1.32.0",
    "oxlint": "1.81.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  }
}
