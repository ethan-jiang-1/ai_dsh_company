{
  "name": "ai-dsh-company",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "dsh": "node --import tsx/esm vendor/dsh/apps/cli/src/bin.ts",
    "bundle:init": "node tools/bundle-init.mjs",
    "standalone": "node tools/standalone.mjs",
    "orient": "node tools/orient.mjs",
    "diagnose": "node tools/diagnose.mjs",
    "verify": "node checks/run-gates.mjs",
    "test": "vitest run",
    "typecheck": "node ./node_modules/typescript/bin/tsc -b packages/company-pack",
    "release": "node tools/release.mjs",
    "release:check": "node tools/release.mjs --check",
    "release:prepare": "node tools/release.mjs --prepare",
    "release:verify": "node tools/release.mjs --verify",
    "release:stamp": "node tools/release.mjs --stamp",
    "release:all": "node tools/release.mjs --all",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent-preset": "workspace:*",
    "@deepseek-ai/dsh-agent-preset-registry": "workspace:*",
    "@deepseek-ai/dsh-browser-use": "workspace:*",
    "@deepseek-ai/dsh-command-compact": "workspace:*",
    "@deepseek-ai/dsh-command-goal": "workspace:*",
    "@deepseek-ai/dsh-compaction-basic": "workspace:*",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "workspace:*",
    "@deepseek-ai/dsh-experimental-agent-team": "workspace:*",
    "@deepseek-ai/dsh-experimental-browser-use-playwright-mcp": "workspace:*",
    "@deepseek-ai/dsh-experimental-client-ui-agent-team": "workspace:*",
    "@deepseek-ai/dsh-experimental-tool-agent-team": "workspace:*",
    "@deepseek-ai/dsh-llm-replay": "workspace:*",
    "@deepseek-ai/dsh-persona": "workspace:*",
    "@deepseek-ai/dsh-plan-mode": "workspace:*",
    "@deepseek-ai/dsh-session-query-sqlite": "workspace:*",
    "@deepseek-ai/dsh-session-snapshot": "workspace:*",
    "@deepseek-ai/dsh-skill-filesystem": "workspace:*",
    "@deepseek-ai/dsh-tool-ask-user": "workspace:*",
    "@deepseek-ai/dsh-tool-fs": "workspace:*",
    "@deepseek-ai/dsh-tool-fs-search": "workspace:*",
    "@deepseek-ai/dsh-tool-goal": "workspace:*",
    "@deepseek-ai/dsh-tool-jobs": "workspace:*",
    "@deepseek-ai/dsh-tool-present": "workspace:*",
    "@deepseek-ai/dsh-tool-session-query": "workspace:*",
    "@deepseek-ai/dsh-tool-skill": "workspace:*",
    "@deepseek-ai/dsh-tool-subagent": "workspace:*",
    "@deepseek-ai/dsh-tool-todo": "workspace:*",
    "@deepseek-ai/dsh-tool-web": "workspace:*",
    "@deepseek-ai/dsh-tool-workflow": "workspace:*",
    "@deepseek-ai/dsh-workflow-ptc": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "^4.1.11",
    "dsh-company-pack": "workspace:*",
    "lightningcss": "^1.32.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  }
