{
  "extends": "./packages/company-pack/tsconfig.host.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["node"],
    "paths": {
      "@deepseek-ai/*": ["./packages/company-pack/node_modules/@deepseek-ai/*"],
      "@deepseek-ai/dsh-api-session-controller/client": ["./packages/company-pack/node_modules/@deepseek-ai/dsh-api-session-controller/lib/types/client/index.d.ts"],
      "@deepseek-ai/dsh-api-session-controller/types": ["./packages/company-pack/node_modules/@deepseek-ai/dsh-api-session-controller/lib/types/types.d.ts"],
      "@deepseek-ai/dsh-session/types": ["./packages/company-pack/node_modules/@deepseek-ai/dsh-session/lib/types/types.d.ts"]
    }
  },
  "include": ["tests/company/**/*.ts", "tests/support/temp-env.ts", "tests/support/cultivation-harness.ts"],
  "exclude": [
    "tests/company/apply-lifecycle.spec.ts",
    "tests/company/fs-record-sandbox.spec.ts",
    "tests/company/cultivation-propose-guards.spec.ts",
    "tests/company/fs-record-write.spec.ts",
    "tests/company/presented-domain-real.spec.ts",
    "tests/company/host-composition.spec.ts",
    "tests/company/catalog.spec.ts"
  ]
}
