{
  "extends": "./packages/company-pack/tsconfig.host.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": [
      "node"
    ],
    "paths": {
      "@deepseek-ai/*": [
        "./packages/company-pack/node_modules/@deepseek-ai/*"
      ],
      "@deepseek-ai/dsh-api-session-controller/client": [
        "./packages/company-pack/node_modules/@deepseek-ai/dsh-api-session-controller/lib/types/client/index.d.ts"
      ],
      "@deepseek-ai/dsh-api-session-controller/types": [
        "./packages/company-pack/node_modules/@deepseek-ai/dsh-api-session-controller/lib/types/types.d.ts"
      ],
      "@deepseek-ai/dsh-session/types": [
        "./packages/company-pack/node_modules/@deepseek-ai/dsh-session/lib/types/types.d.ts"
      ]
    }
  },
  "include": [
    "tests/host/**/*.ts",
    "tests/lib/**/*.ts",
    "tests/content/**/*.ts",
    "tests/support/temp-env.ts",
    "tests/support/cultivation-harness.ts"
  ],
  "exclude": [
    "tests/host/index/apply-lifecycle.spec.ts",
    "tests/host/cultivation/fs-record-sandbox.spec.ts",
    "tests/host/index/cultivation-propose-guards.spec.ts",
    "tests/host/cultivation/fs-record-write.spec.ts",
    "tests/host/ledger/presented-domain-real.spec.ts",
    "tests/host/index/host-composition.spec.ts",
    "tests/host/ledger/catalog.spec.ts"
  ]
}
