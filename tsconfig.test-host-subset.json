{
  "extends": "./packages/company-pack/tsconfig.host.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["node"]
  },
  "include": ["tests/company/**/*.ts", "tests/harness/**/*.ts", "tests/support/**/*.ts"],
  "exclude": [
    "tests/company/apply-lifecycle.spec.ts",
    "tests/company/fs-record-sandbox.spec.ts",
    "tests/company/cultivation-propose-guards.spec.ts",
    "tests/company/fs-record-write.spec.ts",
    "tests/company/presented-domain-real.spec.ts",
    "tests/company/host-composition.spec.ts",
    "tests/company/catalog.spec.ts",
    "tests/harness/pack-exports.spec.ts",
    "tests/harness/company-tab-catalog.spec.ts"
  ]
}
