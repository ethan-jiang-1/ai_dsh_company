{
  "extends": "./packages/company-pack/tsconfig.client.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "typeRoots": [
      "./vendor/dsh/scripts/types",
      "./vendor/dsh/node_modules/@types",
      "./node_modules/@types"
    ],
    "types": [
      "client-build-environment",
      "node",
      "react",
      "react-dom"
    ],
    "paths": {
      "@deepseek-ai/*": [
        "./packages/company-pack/node_modules/@deepseek-ai/*"
      ],
      "@deepseek-ai/dsh-api-session-controller/client": [
        "./packages/company-pack/node_modules/@deepseek-ai/dsh-api-session-controller/lib/types/client/index.d.ts"
      ],
      "@deepseek-ai/dsh-api-session-controller/types": [
        "./packages/company-pack/node_modules/@deepseek-ai/dsh-api-session-controller/lib/types/types.d.ts"
      ],
      "@deepseek-ai/dsh-session/types": [
        "./packages/company-pack/node_modules/@deepseek-ai/dsh-session/lib/types/types.d.ts"
      ],
      "react": [
        "./vendor/dsh/node_modules/@types/react"
      ],
      "react/*": [
        "./vendor/dsh/node_modules/@types/react/*"
      ],
      "react-dom/*": [
        "./vendor/dsh/node_modules/@types/react-dom/*"
      ]
    }
  },
  "include": [
    "tests/client/**/*.ts",
    "tests/client/**/*.tsx",
    "tests/support/temp-env.ts"
  ],
  "exclude": [
    "tests/client/tabs/company-tab-registration.spec.ts",
    "tests/client/company-client-composition.spec.ts",
    "tests/client/ui/style-lifecycle.spec.ts"
  ]
}
