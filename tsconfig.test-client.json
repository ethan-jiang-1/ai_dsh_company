{
  "extends": "./packages/company-pack/tsconfig.client.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "composite": false,
    "incremental": true,
    "tsBuildInfoFile": "./runtime/tsc-cache/test-client.tsbuildinfo",
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "typeRoots": [
      "./vendor/dsh/scripts/types",
      "./vendor/dsh/node_modules/@types",
      "./node_modules/@types"
    ],
    "types": [
      "client-build-environment",
      "node",
      "react",
      "react-dom"
    ],
    "paths": {
      "@deepseek-ai/*": [
        "./packages/company-pack/node_modules/@deepseek-ai/*"
      ],
      "@deepseek-ai/dsh-api-session-controller/client": [
        "./packages/company-pack/node_modules/@deepseek-ai/dsh-api-session-controller/lib/types/client/index.d.ts"
      ],
      "@deepseek-ai/dsh-api-session-controller/types": [
        "./packages/company-pack/node_modules/@deepseek-ai/dsh-api-session-controller/lib/types/types.d.ts"
      ],
      "@deepseek-ai/dsh-session/types": [
        "./packages/company-pack/node_modules/@deepseek-ai/dsh-session/lib/types/types.d.ts"
      ],
      "@deepseek-ai/dsh-client-locale/client": [
        "./vendor/dsh/packages/client/locale/lib/types/client/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-ui-renderer/client": [
        "./vendor/dsh/packages/client/ui-renderer/lib/types/client/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-ui-sidebar-right/client": [
        "./vendor/dsh/packages/client/ui-sidebar-right/lib/types/client/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-ui-sidebar-right/tab-registry": [
        "./vendor/dsh/packages/client/ui-sidebar-right/lib/types/client/tab-registry.d.ts"
      ],
      "@deepseek-ai/dsh-remote-mock": [
        "./vendor/dsh/packages/test-support/remote-mock/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-test-runtime/assembly/bundle-roster": [
        "./vendor/dsh/packages/test-support/client-runtime/lib/types/assembly/bundle-roster.d.ts"
      ],
      "@deepseek-ai/dsh-client-test-runtime/assembly": [
        "./vendor/dsh/packages/test-support/client-runtime/lib/types/assembly/index.d.ts"
      ],
      "react": [
        "./vendor/dsh/node_modules/@types/react"
      ],
      "react/*": [
        "./vendor/dsh/node_modules/@types/react/*"
      ],
      "react-dom/*": [
        "./vendor/dsh/node_modules/@types/react-dom/*"
      ]
    }
  },
  "include": [
    "tests/client/**/*.ts",
    "tests/client/**/*.tsx",
    "tests/support/temp-env.ts",
    "tests/support/i18n-assertions.ts"
  ]
}
